{
  "uid": "microservices-overview",
  "title": "Microservices Overview",
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "row",
      "title": "🐇 RabbitMQ — Message Queue",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Jobs Waiting (judge.jobs)",
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      },
      "targets": [{ "expr": "rabbitmq_queue_messages_ready{queue=\"judge.jobs\"}", "legendFormat": "ready", "refId": "A" }],
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 }
    },
    {
      "type": "stat",
      "title": "Unacked Messages (judge.jobs)",
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      },
      "targets": [{ "expr": "rabbitmq_queue_messages_unacknowledged{queue=\"judge.jobs\"}", "legendFormat": "unacked", "refId": "A" }],
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 }
    },
    {
      "type": "stat",
      "title": "Results Waiting (judge.results)",
      "datasource": "Prometheus",
      "targets": [{ "expr": "rabbitmq_queue_messages_ready{queue=\"judge.results\"}", "legendFormat": "ready", "refId": "A" }],
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 }
    },
    {
      "type": "stat",
      "title": "Total Connections",
      "datasource": "Prometheus",
      "targets": [{ "expr": "rabbitmq_connections", "legendFormat": "connections", "refId": "A" }],
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 }
    },
    {
      "type": "timeseries",
      "title": "Queue Messages Over Time",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "rabbitmq_queue_messages_ready", "legendFormat": "{{queue}} ready", "refId": "A" },
        { "expr": "rabbitmq_queue_messages_unacknowledged", "legendFormat": "{{queue}} unacked", "refId": "B" }
      ],
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 6 }
    },
    {
      "type": "row",
      "title": "🌐 HTTP — Request Metrics",
      "gridPos": { "x": 0, "y": 11, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Request Rate by Service (req/s)",
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (application)", "legendFormat": "{{application}}", "refId": "A" }],
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "Error Rate (5xx)",
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" }
        }
      },
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m])) by (application)", "legendFormat": "{{application}}", "refId": "A" }],
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "P99 Latency by Service (ms)",
      "datasource": "Prometheus",
      "targets": [{ "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket[1m])) by (le, application)) * 1000", "legendFormat": "{{application}} p99", "refId": "A" }],
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 6 }
    },
    {
      "type": "row",
      "title": "☕ JVM — Memory & Threads",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "JVM Heap Memory Used",
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(jvm_memory_used_bytes{area=\"heap\"}) by (application) / 1024 / 1024", "legendFormat": "{{application}} (MB)", "refId": "A" }],
      "gridPos": { "x": 0, "y": 25, "w": 12, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "JVM Non-Heap Memory Used",
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(jvm_memory_used_bytes{area=\"nonheap\"}) by (application) / 1024 / 1024", "legendFormat": "{{application}} (MB)", "refId": "A" }],
      "gridPos": { "x": 12, "y": 25, "w": 12, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "JVM Live Threads",
      "datasource": "Prometheus",
      "targets": [{ "expr": "jvm_threads_live_threads", "legendFormat": "{{application}}", "refId": "A" }],
      "gridPos": { "x": 0, "y": 31, "w": 12, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "GC Pause Time",
      "datasource": "Prometheus",
      "targets": [{ "expr": "rate(jvm_gc_pause_seconds_sum[1m])", "legendFormat": "{{application}} {{action}}", "refId": "A" }],
      "gridPos": { "x": 12, "y": 31, "w": 12, "h": 6 }
    },
    {
      "type": "row",
      "title": "🗄️ Database — Connection Pool",
      "gridPos": { "x": 0, "y": 37, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "DB Active Connections",
      "datasource": "Prometheus",
      "targets": [{ "expr": "hikaricp_connections_active", "legendFormat": "{{application}} active", "refId": "A" }],
      "gridPos": { "x": 0, "y": 38, "w": 12, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "DB Connection Wait Time",
      "datasource": "Prometheus",
      "targets": [{ "expr": "rate(hikaricp_connections_timeout_total[1m])", "legendFormat": "{{application}} timeout/s", "refId": "A" }],
      "gridPos": { "x": 12, "y": 38, "w": 12, "h": 6 }
    }
  ]
}
